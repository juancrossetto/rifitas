generator client {
  provider        = "prisma-client-js"
  output          = "../src/generated/prisma"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model Raffle {
  id             String         @id @default(cuid())
  slug           String         @unique
  title          String
  description    String
  imageUrls      String[]
  cloudinaryIds  String[]
  totalTickets   Int
  ticketPrice    Float
  prizes         String[]
  drawDate       DateTime
  status         RaffleStatus   @default(DRAFT)
  paymentMethods PaymentMethod[]
  whatsappNumber String?
  bankHolder     String?
  bankCbu        String?
  bankAlias      String?
  bankNote       String?
  primaryColor   String?
  secondaryColor String?
  tickets        Ticket[]
  orders         Order[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model Ticket {
  id        String       @id @default(cuid())
  number    Int
  raffleId  String
  raffle    Raffle       @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  status    TicketStatus @default(AVAILABLE)
  orderId   String?
  order     Order?       @relation(fields: [orderId], references: [id])
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([raffleId, number])
  @@index([raffleId, status])
}

model Order {
  id             String        @id @default(cuid())
  raffleId       String
  raffle         Raffle        @relation(fields: [raffleId], references: [id])
  buyerName      String
  buyerEmail     String
  buyerPhone     String
  tickets        Ticket[]
  totalAmount    Float
  paymentMethod  PaymentMethod
  status         OrderStatus   @default(PENDING)
  mpPreferenceId String?
  mpPaymentId    String?
  mpStatus       String?
  expiresAt      DateTime?
  confirmedAt    DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
}

enum RaffleStatus {
  DRAFT
  ACTIVE
  CLOSED
  FINISHED
}

enum TicketStatus {
  AVAILABLE
  RESERVED
  SOLD
}

enum OrderStatus {
  PENDING
  CONFIRMED
  EXPIRED
  CANCELLED
}

enum PaymentMethod {
  MERCADOPAGO
  WHATSAPP
  TRANSFER
}
